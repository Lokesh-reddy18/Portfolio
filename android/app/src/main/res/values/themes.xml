<resources>
    <!-- Shown by the system before the app draws anything; the SplashScreen API backports it below Android 12. -->
    <style name="Theme.Portfolio.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Portfolio</item>
    </style>

    <!-- Only used before Compose draws its first frame; the Compose MaterialTheme styles everything after. -->
    <style name="Theme.Portfolio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
    </style>
</resources>
